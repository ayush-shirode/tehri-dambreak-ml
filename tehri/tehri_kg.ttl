@prefix dbk: <http://example.org/dambreak#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dbk:Froehlich1995 a dbk:Source ;
    dbk:citation "D. C. Froehlich, peak outflow regression (1995); equation as given in USACE HEC-RAS Hydraulic Reference Manual" ;
    dbk:url "https://www.hec.usace.army.mil/confluence/rasdocs/ras1dtechref/6.2/performing-a-dam-break-study-with-hec-ras/estimating-dam-breach-parameters/estimating-breach-parameters"^^xsd:anyURI .

dbk:TehriDam a dbk:Dam ;
    rdfs:label "Tehri Dam" ;
    dbk:breachModel dbk:Froehlich2008Model,
        dbk:VonThun1990Model ;
    dbk:hasParameter dbk:TehriDam_crestElevation,
        dbk:TehriDam_crestLength,
        dbk:TehriDam_height,
        dbk:TehriDam_spillwayCapacity,
        dbk:TehriDam_type ;
    dbk:impounds dbk:TehriReservoir ;
    dbk:onRiver dbk:Bhagirathi ;
    dbk:peakFlowCheck dbk:Froehlich1995Peak ;
    dbk:releasesInto dbk:TehriDownstreamReach .

dbk:TehriScenarioSpace a dbk:ScenarioSpace ;
    rdfs:label "Uncertain inputs for Tehri breach scenarios" ;
    dbk:hasParameter dbk:TehriScenarioSpace_breachTimeRange,
        dbk:TehriScenarioSpace_breachWidthFactor,
        dbk:TehriScenarioSpace_failureMode,
        dbk:TehriScenarioSpace_manningN,
        dbk:TehriScenarioSpace_reservoirLevel .

dbk:Froehlich1995Peak a dbk:PeakFlowModel ;
    rdfs:label "Froehlich (1995) peak outflow" ;
    dbk:equation "Qp = 0.607*Vw^0.295*hw^1.24 [m3/s]" .

dbk:Froehlich2008Model a dbk:BreachModel ;
    rdfs:label "Froehlich (2008) regression" ;
    dbk:equation "B_avg = 0.27*K0*Vw^0.32*hb^0.04 [m]; t_f = 63.2*sqrt(Vw/(g*hb^2)) [s]" ;
    dbk:hasParameter dbk:Froehlich2008Model_K0_overtopping,
        dbk:Froehlich2008Model_K0_piping,
        dbk:Froehlich2008Model_databaseDamHeight,
        dbk:Froehlich2008Model_databaseVolume,
        dbk:Froehlich2008Model_sideSlope_overtopping,
        dbk:Froehlich2008Model_sideSlope_piping .

dbk:Froehlich2008Model_K0_overtopping a dbk:Parameter ;
    dbk:name "K0_overtopping" ;
    dbk:source dbk:Froehlich2008 ;
    dbk:status "sourced" ;
    dbk:unit "-" ;
    dbk:value 1.3e+00 .

dbk:Froehlich2008Model_K0_piping a dbk:Parameter ;
    dbk:name "K0_piping" ;
    dbk:source dbk:Froehlich2008 ;
    dbk:status "sourced" ;
    dbk:unit "-" ;
    dbk:value 1e+00 .

dbk:Froehlich2008Model_databaseDamHeight a dbk:Parameter ;
    dbk:max 9.296e+01 ;
    dbk:min 3.05e+00 ;
    dbk:name "databaseDamHeight" ;
    dbk:source dbk:Froehlich2008 ;
    dbk:status "sourced" ;
    dbk:unit "m" .

dbk:Froehlich2008Model_databaseVolume a dbk:Parameter ;
    dbk:max 6.6e+08 ;
    dbk:min 1.39e+04 ;
    dbk:name "databaseVolume" ;
    dbk:source dbk:Froehlich2008 ;
    dbk:status "sourced" ;
    dbk:unit "m3" .

dbk:Froehlich2008Model_sideSlope_overtopping a dbk:Parameter ;
    dbk:name "sideSlope_overtopping" ;
    dbk:source dbk:Froehlich2008 ;
    dbk:status "sourced" ;
    dbk:unit "H:V" ;
    dbk:value 1e+00 .

dbk:Froehlich2008Model_sideSlope_piping a dbk:Parameter ;
    dbk:name "sideSlope_piping" ;
    dbk:source dbk:Froehlich2008 ;
    dbk:status "sourced" ;
    dbk:unit "H:V" ;
    dbk:value 7e-01 .

dbk:LightBrushTrees a dbk:LandCoverClass ;
    rdfs:label "Flood plain, light brush and trees (summer)" ;
    dbk:hasParameter dbk:LightBrushTrees_manningN .

dbk:LightBrushTrees_manningN a dbk:Parameter ;
    dbk:max 8e-02 ;
    dbk:min 4e-02 ;
    dbk:name "manningN" ;
    dbk:source dbk:Chow1959 ;
    dbk:status "sourced" ;
    dbk:unit "s m^-1/3" .

dbk:MountainStreamBoulders a dbk:LandCoverClass ;
    rdfs:label "Natural mountain stream, bed of cobbles with large boulders" ;
    dbk:hasParameter dbk:MountainStreamBoulders_manningN .

dbk:MountainStreamBoulders_manningN a dbk:Parameter ;
    dbk:max 7e-02 ;
    dbk:min 4e-02 ;
    dbk:name "manningN" ;
    dbk:source dbk:Chow1959 ;
    dbk:status "sourced" ;
    dbk:unit "s m^-1/3" .

dbk:TehriDam_crestElevation a dbk:Parameter ;
    dbk:name "crestElevation" ;
    dbk:source dbk:THDC_ICOLD2021 ;
    dbk:status "sourced" ;
    dbk:unit "m a.s.l." ;
    dbk:value 8.395e+02 .

dbk:TehriDam_crestLength a dbk:Parameter ;
    dbk:name "crestLength" ;
    dbk:source dbk:THDC_Tehri ;
    dbk:status "sourced" ;
    dbk:unit "m" ;
    dbk:value 5.75e+02 .

dbk:TehriDam_height a dbk:Parameter ;
    dbk:name "height" ;
    dbk:source dbk:THDC_Tehri ;
    dbk:status "sourced" ;
    dbk:unit "m" ;
    dbk:value 2.605e+02 .

dbk:TehriDam_spillwayCapacity a dbk:Parameter ;
    dbk:name "spillwayCapacity" ;
    dbk:source dbk:THDC_ICOLD2021 ;
    dbk:status "sourced" ;
    dbk:unit "m3/s" ;
    dbk:value 1.3043e+04 .

dbk:TehriDam_type a dbk:Parameter ;
    dbk:name "type" ;
    dbk:source dbk:THDC_Tehri ;
    dbk:status "sourced" ;
    dbk:unit "-" ;
    rdfs:comment "Earth and rockfill dam" .

dbk:TehriDownstreamReach a dbk:RiverReach ;
    rdfs:label "Bhagirathi downstream of Tehri Dam" ;
    dbk:hasLandCover dbk:LightBrushTrees,
        dbk:MountainStreamBoulders ;
    dbk:partOf dbk:Bhagirathi .

dbk:TehriReservoir a dbk:Reservoir ;
    rdfs:label "Tehri reservoir" ;
    dbk:hasParameter dbk:TehriReservoir_FRL,
        dbk:TehriReservoir_MDDL,
        dbk:TehriReservoir_MWL,
        dbk:TehriReservoir_catchmentArea,
        dbk:TehriReservoir_deadStorage,
        dbk:TehriReservoir_designFloodPMF,
        dbk:TehriReservoir_grossStorage,
        dbk:TehriReservoir_liveStorage,
        dbk:TehriReservoir_maxObservedFlood .

dbk:TehriReservoir_FRL a dbk:Parameter ;
    dbk:name "FRL" ;
    dbk:source dbk:THDC_ICOLD2021 ;
    dbk:status "sourced" ;
    dbk:unit "m a.s.l." ;
    dbk:value 8.3e+02 .

dbk:TehriReservoir_MDDL a dbk:Parameter ;
    dbk:name "MDDL" ;
    dbk:source dbk:THDC_ICOLD2021 ;
    dbk:status "sourced" ;
    dbk:unit "m a.s.l." ;
    dbk:value 7.4e+02 .

dbk:TehriReservoir_MWL a dbk:Parameter ;
    dbk:name "MWL" ;
    dbk:source dbk:THDC_ICOLD2021 ;
    dbk:status "sourced" ;
    dbk:unit "m a.s.l." ;
    dbk:value 8.35e+02 .

dbk:TehriReservoir_catchmentArea a dbk:Parameter ;
    dbk:name "catchmentArea" ;
    dbk:source dbk:THDC_ICOLD2021 ;
    dbk:status "sourced" ;
    dbk:unit "km2" ;
    dbk:value 7.511e+03 .

dbk:TehriReservoir_deadStorage a dbk:Parameter ;
    dbk:name "deadStorage" ;
    dbk:status "derived" ;
    dbk:unit "m3" ;
    dbk:value 9.25e+08 ;
    rdfs:comment "gross minus live storage = storage at MDDL" .

dbk:TehriReservoir_designFloodPMF a dbk:Parameter ;
    dbk:name "designFloodPMF" ;
    dbk:source dbk:THDC_ICOLD2021 ;
    dbk:status "sourced" ;
    dbk:unit "m3/s" ;
    dbk:value 1.554e+04 .

dbk:TehriReservoir_grossStorage a dbk:Parameter ;
    dbk:name "grossStorage" ;
    dbk:source dbk:THDC_Tehri ;
    dbk:status "sourced" ;
    dbk:unit "m3" ;
    dbk:value 3.54e+09 ;
    rdfs:comment "gross storage at FRL" .

dbk:TehriReservoir_liveStorage a dbk:Parameter ;
    dbk:name "liveStorage" ;
    dbk:source dbk:THDC_Tehri ;
    dbk:status "sourced" ;
    dbk:unit "m3" ;
    dbk:value 2.615e+09 .

dbk:TehriReservoir_maxObservedFlood a dbk:Parameter ;
    dbk:name "maxObservedFlood" ;
    dbk:source dbk:THDC_ICOLD2021 ;
    dbk:status "sourced" ;
    dbk:unit "m3/s" ;
    dbk:value 7.5e+03 .

dbk:TehriScenarioSpace_breachTimeRange a dbk:Parameter ;
    dbk:name "breachTimeRange" ;
    dbk:status "derived" ;
    dbk:unit "s" ;
    rdfs:comment "per scenario: between Froehlich (2008) and Von Thun-Gillette (1990, erosion resistant) estimates; both equations are extrapolated because Tehri exceeds their database range" .

dbk:TehriScenarioSpace_breachWidthFactor a dbk:Parameter ;
    dbk:max 1.3e+00 ;
    dbk:min 7e-01 ;
    dbk:name "breachWidthFactor" ;
    dbk:status "assumption" ;
    dbk:unit "-" ;
    rdfs:comment "ASSUMPTION: +/-30% about Froehlich (2008) width to represent extrapolation uncertainty; no sourced interval" .

dbk:TehriScenarioSpace_failureMode a dbk:Parameter ;
    dbk:name "failureMode" ;
    dbk:source dbk:Froehlich2008 ;
    dbk:status "sourced" ;
    dbk:unit "-" ;
    rdfs:comment "piping (K0=1.0, z=0.7) or overtopping (K0=1.3, z=1.0)" .

dbk:TehriScenarioSpace_manningN a dbk:Parameter ;
    dbk:max 7e-02 ;
    dbk:min 4e-02 ;
    dbk:name "manningN" ;
    dbk:source dbk:Chow1959 ;
    dbk:status "sourced" ;
    dbk:unit "s m^-1/3" .

dbk:TehriScenarioSpace_reservoirLevel a dbk:Parameter ;
    dbk:max 8.35e+02 ;
    dbk:min 7.4e+02 ;
    dbk:name "reservoirLevel" ;
    dbk:source dbk:THDC_ICOLD2021 ;
    dbk:status "sourced" ;
    dbk:unit "m a.s.l." ;
    rdfs:comment "operating range MDDL..MWL; piping failures sampled in this range" .

dbk:VonThun1990 a dbk:Source ;
    dbk:citation "J. L. Von Thun and D. R. Gillette, 'Guidance on breach parameters', USBR internal memorandum (1990); equations as given in USACE HEC-RAS Hydraulic Reference Manual" ;
    dbk:url "https://www.hec.usace.army.mil/confluence/rasdocs/ras1dtechref/6.2/performing-a-dam-break-study-with-hec-ras/estimating-dam-breach-parameters/estimating-breach-parameters"^^xsd:anyURI .

dbk:VonThun1990Model a dbk:BreachModel ;
    rdfs:label "Von Thun and Gillette (1990)" ;
    dbk:equation "t_f = 0.02*hw + 0.25 [h] (erosion resistant); t_f = 0.015*hw [h] (easily erodible)" ;
    dbk:hasParameter dbk:VonThun1990Model_databaseDamHeight .

dbk:VonThun1990Model_databaseDamHeight a dbk:Parameter ;
    dbk:max 9.296e+01 ;
    dbk:min 3.66e+00 ;
    dbk:name "databaseDamHeight" ;
    dbk:source dbk:VonThun1990 ;
    dbk:status "sourced" ;
    dbk:unit "m" .

dbk:Bhagirathi a dbk:River ;
    rdfs:label "Bhagirathi River" .

dbk:Chow1959 a dbk:Source ;
    dbk:citation "V. T. Chow, Open-Channel Hydraulics (McGraw-Hill, 1959), Table 5-6; reproduced in FHWA HDS-6 Table 2.1" ;
    dbk:url "https://www.scdot.org/business/technicalPDFs/hydraulic/Chow%20from%20HDS%206.pdf"^^xsd:anyURI .

dbk:THDC_Tehri a dbk:Source ;
    dbk:citation "THDC India Ltd., Tehri Dam & HPP (Stage-I), technical parameters" ;
    dbk:url "https://thdc.co.in/en/projects/hydro/tehri-dam-HPP-stage-I"^^xsd:anyURI .

dbk:Froehlich2008 a dbk:Source ;
    dbk:citation "D. C. Froehlich, J. Hydraul. Eng. 134(12), 1708-1721 (2008); equations as given in USACE HEC-RAS Hydraulic Reference Manual, 'Estimating breach parameters'" ;
    dbk:url "https://www.hec.usace.army.mil/confluence/rasdocs/ras1dtechref/6.2/performing-a-dam-break-study-with-hec-ras/estimating-dam-breach-parameters/estimating-breach-parameters"^^xsd:anyURI .

dbk:THDC_ICOLD2021 a dbk:Source ;
    dbk:citation "A. Singh, M. Mani, R. Vishnoi (THDC India Ltd.), 'Tehri Dam - saviour from extreme events', ICOLD 2021 workshop on reservoir operation for handling extreme events, CBIP" ;
    dbk:url "https://www.cbip.org/ISRM-2022/ICOLD2021/Data/Workshop/Reservoir%20Operation%20for%20handling%20of%20Extreme%20Events/Tehri%20dam_Savior%20from%20extreme%20events_Final10-01-2020-17-31-07.pdf"^^xsd:anyURI .

